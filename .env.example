# Application Setup
# All site content (projects, blogs, stack, social links, resume) comes from Sanity.
# Seed an empty dataset with: npm run migrate:sanity
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity CMS Public Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-19

# Sanity Server-Side Tokens (NEVER exposed to the browser)
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# GitHub Integration
# Username is taken from the GitHub URL in Sanity (Connect & Social Links).
# Set GITHUB_USERNAME only to override it.
GITHUB_USERNAME=

# GitHub Personal Access Token (PAT) used by the server-side GraphQL client for contribution graph
GITHUB_ACCESS_TOKEN=

# LeetCode Integration
# Username is taken from the LeetCode URL in Sanity (Connect & Social Links).
# Set LEETCODE_USERNAME only to override it.
LEETCODE_USERNAME=

# Spotify Integration (Optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Resend Email Integration (Server-Side Only)
RESEND_API_KEY=
# Recipient defaults to the email in Sanity (Connect & Social Links); set to override.
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

